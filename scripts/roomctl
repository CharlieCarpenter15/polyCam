#!/usr/bin/env bash
#
# roomctl — everything you might need to do to the room, from a terminal.
#
# The web control panel covers the same ground without a keyboard; this exists
# for SSH, for first-time setup, and for when the dashboard itself is the thing
# that is broken.
#
#   roomctl status                     how is the room?
#   roomctl screen                     why is the TV blank / white / wrong?
#   roomctl performance [auto|high|balanced|low]
#                                      how hard to push this machine
#   roomctl slow-device on|off         retune for a Pi 3 / older hardware
#   roomctl port [N|auto]              show / set / auto-pick the dashboard port
#   roomctl doctor                     run every hardware check
#   roomctl restart [what]             browser | airplay | remote | backend | all
#   roomctl start|stop [what]
#   roomctl logs [unit] [-f]           recent logs, optionally follow
#   roomctl config                     show every setting
#   roomctl get KEY                    show one setting
#   roomctl set KEY VALUE              change one setting
#   roomctl calendar <ics-url>         set the room calendar
#   roomctl pin <digits>               set the admin PIN
#   roomctl lan-admin on|off           allow settings from the network
#   roomctl panel                      print the control panel address
#   roomctl qr                         the phone controller address + code
#   roomctl qr new                     issue a new pairing code
#   roomctl minutes [status]           meeting minutes: what the feature is doing
#   roomctl minutes list [n]           the last n meetings recorded
#   roomctl minutes show [id]          one meeting; --transcript / --summary alone
#   roomctl minutes process <id>       write that meeting up again
#   roomctl minutes delete <id>        remove a meeting for good
#   roomctl minutes sweep              apply the retention policy now
#   roomctl minutes people             who the room has been taught to recognise
#   roomctl update                     pull the latest room software now
#   roomctl reset                      settings back to defaults (keeps calendar)
#   roomctl reboot
#   roomctl enable|disable             the whole appliance on/off at boot

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib-room.sh
. "$HERE/lib-room.sh"

UNITS=(room-dashboard.service room-kiosk.service room-airplay.service
       room-remote.service room-watchdog.timer)

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
dim()  { printf '\033[2m%s\033[0m\n' "$*"; }
red()  { printf '\033[31m%s\033[0m\n' "$*"; }
green(){ printf '\033[32m%s\033[0m\n' "$*"; }
good() { printf '  \033[32m\xe2\x9c\x93\033[0m %s\n' "$*"; }

usage() { sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

py() {
  local python
  python="$(room_python)" || { red "Python not found."; exit 1; }
  (cd "$ROOM_ROOT" && "$python" "$@")
}

resolve_unit() {
  case "$1" in
    browser | kiosk | chromium | display | tv) printf 'room-kiosk.service' ;;
    airplay | uxplay | sharing)                printf 'room-airplay.service' ;;
    remote | controller)                       printf 'room-remote.service' ;;
    backend | dashboard | app | software)      printf 'room-dashboard.service' ;;
    watchdog)                                  printf 'room-watchdog.timer' ;;
    *) return 1 ;;
  esac
}

# ------------------------------------------------------------------ commands

cmd_status() {
  room_load_config || true
  local port; port="$(room_config DASHBOARD_PORT 8080)"

  bold "Services"
  local unit state
  for unit in "${UNITS[@]}"; do
    state="$(systemctl --user is-active "$unit" 2>/dev/null || true)"
    [ -n "$state" ] || state="not installed"
    if [ "$state" = "active" ]; then
      printf '  \033[32m●\033[0m %-26s %s\n' "$unit" "$state"
    else
      printf '  \033[31m●\033[0m %-26s %s\n' "$unit" "$state"
    fi
  done
  printf '\n'

  bold "Room"
  local health_file="/tmp/roomctl-health.$$"
  if command -v curl >/dev/null 2>&1 &&
     curl --silent --fail --max-time 5 "http://127.0.0.1:${port}/api/health" \
       --output "$health_file" 2>/dev/null; then
    py - "$health_file" << 'PYEOF'
import json
import sys

MARKS = {"ok": "\033[32m✓\033[0m", "warning": "\033[33m!\033[0m",
         "error": "\033[31m✗\033[0m", "disabled": "\033[2m–\033[0m"}

with open(sys.argv[1], encoding="utf-8") as handle:
    data = json.load(handle)

print(f"  overall: {data.get('status')}    mode: {data.get('mode')}")
for name, status in (data.get("components") or {}).items():
    print(f"  {MARKS.get(status, '?')} {name}")

backend = data.get("backend") or {}
host = data.get("host") or {}
performance = data.get("performance") or {}
if performance:
    machine = (performance.get("machine") or {}).get("description", "")
    chosen = "auto" if performance.get("automatic") else "set by hand"
    print(f"\n  {machine}\n  running the '{performance.get('profile')}' profile ({chosen})")
print(f"\n  version {backend.get('version')}  "
      f"backend up {round(backend.get('uptime_seconds', 0) / 60)} min  "
      f"pi up {round(host.get('uptime_seconds', 0) / 3600)} h")
if host.get("temperature_c"):
    print(f"  {host['temperature_c']} °C   disk {host.get('disk_free_percent')}% free   "
          f"memory {host.get('memory_available_mb')} MB free")
if backend.get("setup_required"):
    print("\n  \033[33mSetup is not finished: no calendar configured.\033[0m")
for warning in backend.get("config_warnings") or []:
    print(f"  \033[33m{warning}\033[0m")
PYEOF
    rm -f "$health_file"
  else
    red "  The room software is not answering on port $port."
    dim "  Try:  roomctl restart backend   then   roomctl logs backend"
  fi
  printf '\n'
  cmd_panel
}

cmd_panel() {
  room_load_config || true
  local port lan pin address
  port="$(room_config DASHBOARD_PORT 8080)"
  lan="$(room_config ADMIN_LAN_ACCESS false)"
  pin="$(room_config ADMIN_PIN '')"

  bold "Control panel"
  if room_is_true "$lan"; then
    address="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$address" ] || address="$(hostname).local"
    green "  http://${address}:${port}/panel"
    if [ -n "$pin" ]; then
      dim "  PIN required (roomctl pin <digits> to change it)"
    else
      red "  No PIN set — network access is refused until one exists."
    fi
  else
    dim "  http://127.0.0.1:${port}/panel   (this Pi only)"
    dim "  To reach it from a phone:  roomctl lan-admin on"
  fi
}

cmd_qr() {
  room_load_config || true
  local port enabled lan_admin lan_ctrl address code
  port="$(room_config DASHBOARD_PORT 8080)"
  enabled="$(room_config CONTROLLER_ENABLED true)"
  lan_admin="$(room_config ADMIN_LAN_ACCESS false)"
  lan_ctrl="$(room_config CONTROLLER_LAN_ACCESS false)"

  bold "Room controller"
  if ! room_is_true "$enabled"; then
    dim "  Switched off — Settings → Room controller."
    return 0
  fi

  case "${1:-}" in
    new | rotate | reset)
      if py -c 'from app.web_security import rotate_controller_token
rotate_controller_token()' >/dev/null 2>&1; then
        green "  New code issued. Every phone paired so far must scan again."
      else
        red "  Could not issue a new code."
        return 1
      fi
      ;;
  esac

  code="$(py -c 'from app.web_security import controller_token
print(controller_token())' 2>/dev/null | tail -n 1)"
  if [ -z "$code" ]; then
    red "  Could not read the pairing code (var/controller-token)."
    return 1
  fi

  if room_is_true "$lan_admin" || room_is_true "$lan_ctrl"; then
    address="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$address" ] || address="$(hostname).local"
    green "  http://${address}:${port}/c/${code}"
    dim "  This is what the QR code on the TV points at."
  else
    dim "  No phone can reach it yet: the room is listening on this Pi only."
    dim "  Open it up with:  roomctl set CONTROLLER_LAN_ACCESS true"
    dim "                    roomctl restart backend"
  fi
}

cmd_update() {
  bold "Updating the room software"
  "$ROOM_ROOT/scripts/update-on-boot.sh" --restart
}

# port_listener PORT — describe what is listening on a TCP port, or fail.
#
# Layered on purpose: `ss` is present on Raspberry Pi OS and names the process,
# but this has to keep working on a stripped-down image, so it falls back to
# lsof and finally to /proc/net/tcp, which needs no tools at all.
port_listener() {
  local port="$1" out hex

  if command -v ss >/dev/null 2>&1; then
    out="$(ss -tlnp 2>/dev/null | grep -E "[:.]${port}[[:space:]]" || true)"
    if [ -n "$out" ]; then printf '%s\n' "$out"; return 0; fi
  fi

  if command -v lsof >/dev/null 2>&1; then
    out="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | tail -n +2 || true)"
    if [ -n "$out" ]; then printf '%s\n' "$out"; return 0; fi
  fi

  # /proc/net/tcp: field 2 is <hex ip>:<hex port>, field 4 is the state
  # (0A = LISTEN). Checking the state avoids matching an outbound connection
  # that merely happens to use this port at the far end.
  hex="$(printf '%04X' "$port")"
  if awk -v hex="$hex" '$2 ~ ":"hex"$" && $4 == "0A" { found = 1 }
                        END { exit !found }' \
       /proc/net/tcp /proc/net/tcp6 2>/dev/null; then
    printf 'a process is listening on port %s (install iproute2 to see which)\n' "$port"
    return 0
  fi

  return 1
}

cmd_screen() {
  # Answers one question: is the TV blank because the page did not load, or
  # because Chromium loaded it and failed to draw it? Those need different
  # fixes, and guessing between them wastes a lot of time.
  room_load_config || true
  local dash_port debug_port url mode session
  dash_port="$(room_config DASHBOARD_PORT 8080)"
  debug_port="$(room_config CHROMIUM_DEBUG_PORT 9222)"
  mode="$(room_config CHROMIUM_RENDER_MODE auto)"

  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    session="wayland ($WAYLAND_DISPLAY)"
  elif [ -n "${DISPLAY:-}" ]; then
    session="x11 ($DISPLAY)"
  else
    session="none visible from this shell"
  fi

  bold "What is on the TV"
  printf '  render mode : %s\n' "$mode"
  printf '  session     : %s\n' "$session"

  # Probe /api/health and look at the CODE and the BODY, not just success.
  # `curl --fail` treats any error status as "nothing there", so a different
  # program answering 401 on this port looked identical to the room software
  # being down — while actually being a completely different problem.
  local probe_body probe_code
  probe_body="$(mktemp)"
  probe_code="$(curl -s --max-time 5 -o "$probe_body" -w '%{http_code}' \
                "http://127.0.0.1:${dash_port}/api/health" 2>/dev/null || echo 000)"

  if grep -q '"components"' "$probe_body" 2>/dev/null; then
    printf '  backend     : \033[32manswering\033[0m on port %s (HTTP %s)\n' \
      "$dash_port" "$probe_code"
    rm -f "$probe_body"
  elif [ "$probe_code" != "000" ]; then
    # Something is there, but it is not us.
    printf '  backend     : \033[31mwrong program\033[0m on port %s (HTTP %s)\n\n' \
      "$dash_port" "$probe_code"
    bold "Another program is answering on port ${dash_port}."
    if [ "$probe_code" = "401" ] || [ "$probe_code" = "403" ]; then
      dim "It returned HTTP ${probe_code}, which is why the TV shows a browser"
      dim "\"Sign in\" box asking for a username and password. That dialog is"
      dim "Chromium reacting to that program — it is not this appliance, which"
      dim "never asks for a username."
      printf '\n'
    fi
    local owner
    owner="$(port_listener "$dash_port" || true)"
    [ -n "$owner" ] && printf '    %s\n\n' "$(printf '%s' "$owner" | tr -s ' ' | head -3)"
    dim "Find it, then either stop it or move the room to a free port:"
    printf '\n'
    dim "  sudo ss -tlnp | grep :${dash_port}"
    dim "  roomctl set DASHBOARD_PORT 8090 && roomctl restart all"
    rm -f "$probe_body"
    return 1
  else
    printf '  backend     : \033[31mNOT answering\033[0m on port %s\n' "$dash_port"
    printf '\n'

    # Distinguish two very different failures: nothing is listening (the room
    # software is down) versus something else is listening (a port clash, which
    # makes the room restart-loop forever with no obvious cause).
    local holder=""
    holder="$(port_listener "$dash_port" || true)"

    if [ -n "$holder" ]; then
      bold "Something else is using port ${dash_port}."
      printf '    %s\n\n' "$(printf '%s' "$holder" | tr -s ' ')"
      dim "That is why the room software cannot start — it restarts, fails to"
      dim "bind, and tries again. Either stop whatever owns the port, or move"
      dim "the room to a different one:"
      printf '\n'
      dim "  sudo ss -tlnp | grep :${dash_port}      # see it with the process name"
      dim "  roomctl set DASHBOARD_PORT 8090"
      dim "  roomctl restart backend"
      printf '\n'
      dim "If it is a second copy of this appliance, that is the likely culprit:"
      dim "  pgrep -af 'app.main'"
    else
      bold "Nothing is listening on port ${dash_port}."
      dim "The room software is not running. Its own log will say why:"
      printf '\n'
      dim "  roomctl logs backend"
      dim "  roomctl restart backend"
    fi
    rm -f "$probe_body"
    return 1
  fi

  if ! curl -sf --max-time 5 -o /dev/null "http://127.0.0.1:${debug_port}/json/version"; then
    printf '  chromium    : \033[31mnot answering\033[0m on the debug port\n'
    printf '\n'
    dim "Chromium is not running, or not running our kiosk profile."
    dim "  roomctl restart browser"
    dim "  roomctl logs browser"
    return 1
  fi
  printf '  chromium    : \033[32mrunning\033[0m\n'

  url="$(curl -sf --max-time 5 "http://127.0.0.1:${debug_port}/json/list" |
         grep -o '"url": *"[^"]*"' | head -1 | sed 's/.*: *"//; s/"$//')"
  printf '  showing     : %s\n\n' "${url:-unknown}"

  # Match the dashboard's own port, not merely "some localhost URL". Chromium
  # keeps the *requested* URL in /json/list even when the load failed, so a
  # dead port on 127.0.0.1 would otherwise be reported as a healthy page and
  # send you chasing a rendering problem that does not exist.
  case "$url" in
    chrome-error* | about:blank | "")
      bold "The page never loaded."
      dim "Chromium most likely started before the backend was ready."
      dim "  roomctl restart browser"
      ;;
    "http://127.0.0.1:${dash_port}/"* | "http://localhost:${dash_port}/"*)
      bold "The correct page IS loaded."
      dim "So a white or blank screen is Chromium failing to draw, not a problem"
      dim "with the page. Try these in order, checking the TV after each:"
      printf '\n'
      dim "  roomctl set CHROMIUM_RENDER_MODE wayland  && roomctl restart browser"
      dim "  roomctl set CHROMIUM_RENDER_MODE x11      && roomctl restart browser"
      dim "  roomctl set CHROMIUM_RENDER_MODE software && roomctl restart browser"
      printf '\n'
      dim "\"software\" has no GPU acceleration but always draws something. If it"
      dim "works, the other two tell you it is a compositor mismatch."
      ;;
    *)
      bold "Chromium is on an unexpected page."
      dim "  roomctl restart browser"
      ;;
  esac
}

cmd_units() {
  local action="$1"; shift
  local what="${1:-all}"
  local unit

  if [ "$what" = "all" ]; then
    # Order matters on restart: backend first so the browser reloads a live app.
    for unit in room-dashboard.service room-airplay.service room-remote.service room-kiosk.service; do
      printf '  %s %s… ' "$action" "$unit"
      if systemctl --user "$action" "$unit" 2>/dev/null; then green "ok"; else red "failed"; fi
    done
    return 0
  fi

  unit="$(resolve_unit "$what" || true)"
  if [ -z "$unit" ]; then
    red "Unknown target '$what'."
    dim "Use: browser | airplay | remote | backend | watchdog | all"
    exit 1
  fi
  printf '  %s %s… ' "$action" "$unit"
  if systemctl --user "$action" "$unit" 2>/dev/null; then green "ok"; else red "failed"; fi
}

cmd_logs() {
  local unit="" follow=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -f | --follow) follow="-f" ;;
      *) unit="$(resolve_unit "$1" || printf '%s' "$1")" ;;
    esac
    shift
  done
  local args=(--user --no-pager -n 200)
  [ -n "$follow" ] && args+=("$follow")
  if [ -n "$unit" ]; then
    args+=(-u "$unit")
  else
    local u
    for u in "${UNITS[@]}"; do args+=(-u "$u"); done
  fi
  journalctl "${args[@]}"
}

cmd_config() {
  room_load_config || true
  printf '%s\n' "$ROOM_CONFIG_CACHE" | while IFS='=' read -r key value; do
    case "$key" in
      ADMIN_PIN | AIRPLAY_PIN | CALENDAR_ICS_URL)
        [ -n "$value" ] && value="********"
        ;;
    esac
    printf '  %-32s %s\n' "$key" "$value"
  done
}

cmd_get() {
  [ $# -ge 1 ] || { red "Usage: roomctl get KEY"; exit 1; }
  room_load_config || true
  room_config "$1" "(not a setting)"
}

cmd_set() {
  [ $# -ge 2 ] || { red "Usage: roomctl set KEY VALUE"; exit 1; }
  local key="$1"; shift
  local value="$*"
  ROOM_SET_KEY="$key" ROOM_SET_VALUE="$value" py - << 'PYEOF'
import os
import sys

sys.path.insert(0, ".")
from app.config import get_config
from app.config_schema import FIELDS_BY_KEY, SECRET_KEYS

key = os.environ["ROOM_SET_KEY"]
value = os.environ["ROOM_SET_VALUE"]

if key not in FIELDS_BY_KEY:
    print(f"'{key}' is not a setting. Try: roomctl config")
    sys.exit(1)

config = get_config()
changed, errors = config.update({key: value})
if errors:
    for field, problem in errors.items():
        print(f"{field}: {problem}")
    sys.exit(1)

shown = "********" if key in SECRET_KEYS and value else value
if changed:
    print(f"{key} = {shown}")
    units = config.restart_units_for_changes(changed)
    if units:
        print("Restart to apply:  roomctl restart " + " ".join(
            u.replace("room-", "").replace(".service", "").replace(".timer", "")
            for u in units))
else:
    print(f"{key} was already {shown}")
PYEOF
}

cmd_calendar() {
  [ $# -ge 1 ] || { red "Usage: roomctl calendar <ics-url>"; exit 1; }
  cmd_set CALENDAR_SOURCE ics >/dev/null
  cmd_set CALENDAR_ICS_URL "$1"
  dim "Fetching now…"
  py - << 'PYEOF'
import sys
from collections import Counter

sys.path.insert(0, ".")
from app.calendar_service import CalendarService
from app.config import get_config

service = CalendarService(get_config())
service._refresh_once()  # noqa: SLF001 - a deliberate one-shot check
status = service.status()

if not status["ok"]:
    print(f"  \033[31m\u2717\033[0m {status['error']}")
    sys.exit(1)

meetings = service.meetings()
print(f"  \033[32m\u2713\033[0m calendar read: {len(meetings)} meeting(s) in the look-ahead window")

if not meetings:
    print("    Nothing scheduled — that may well be correct.")
    sys.exit(0)

joinable = [m for m in meetings if m.has_link]
mark = "\033[32m\u2713\033[0m" if joinable else "\033[33m!\033[0m"
print(f"  {mark} {len(joinable)} of {len(meetings)} have a join link the room can open")
for provider, count in Counter(m.provider_id for m in joinable).most_common():
    print(f"      {count} x {provider}")

if not joinable:
    print()
    print("    No join links found in any meeting. The usual cause is an Exchange")
    print("    room mailbox stripping the meeting body, which is where the Teams")
    print("    link lives. An Exchange admin can stop that:")
    print()
    print("      Set-CalendarProcessing -Identity <room-mailbox> \\")
    print("        -DeleteComments $false -DeleteSubject $false \\")
    print("        -AddOrganizerToSubject $false")
    print()
    print("    Until then the dashboard lists the meetings, but JOIN will say")
    print("    \"No meeting link\" because there is nothing to open.")
PYEOF
}

cmd_pin() {
  [ $# -ge 1 ] || { red "Usage: roomctl pin <digits>"; exit 1; }
  cmd_set ADMIN_PIN "$1"
}

cmd_lan_admin() {
  local mode="${1:-}"
  case "$mode" in
    on)
      room_load_config || true
      local pin; pin="$(room_config ADMIN_PIN '')"
      if [ -z "$pin" ]; then
        if [ $# -ge 2 ]; then
          cmd_set ADMIN_PIN "$2" || exit 1
        else
          red "Set a PIN first:  roomctl lan-admin on <digits>"
          exit 1
        fi
      fi
      cmd_set ADMIN_LAN_ACCESS true
      cmd_units restart backend
      sleep 2
      cmd_panel
      ;;
    off)
      cmd_set ADMIN_LAN_ACCESS false
      cmd_units restart backend
      ;;
    *)
      red "Usage: roomctl lan-admin on [PIN] | off"
      exit 1
      ;;
  esac
}

cmd_port() {
  # Deliberately not a random port each boot: the control-panel address is
  # something people bookmark on a phone, so it needs to stay put. "auto" picks
  # a free one ONCE and pins it.
  room_load_config || true
  local current
  current="$(room_config DASHBOARD_PORT 8080)"

  case "${1:-}" in
    "")
      bold "Dashboard port"
      printf '  current: %s\n' "$current"
      cmd_panel
      return 0
      ;;
    auto)
      bold "Finding a free port"
      ;;
    *)
      if ! printf '%s' "$1" | grep -qE '^[0-9]+$' || [ "$1" -lt 1024 ] || [ "$1" -gt 65535 ]; then
        red "Give a port between 1024 and 65535, or 'auto'."
        exit 1
      fi
      ;;
  esac

  local chosen
  chosen="$(ROOM_PORT_REQUEST="$1" py - << 'PYEOF'
import os
import socket
import sys

sys.path.insert(0, ".")
from app.config import get_config

request = os.environ.get("ROOM_PORT_REQUEST", "auto")


def bindable(port: int) -> bool:
    """Can we actually listen here? The only test that does not lie."""
    for family, address in ((socket.AF_INET, "127.0.0.1"), (socket.AF_INET, "0.0.0.0")):
        try:
            with socket.socket(family, socket.SOCK_STREAM) as probe:
                probe.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
                probe.bind((address, port))
        except OSError:
            return False
    return True


if request == "auto":
    # A short, stable, memorable list rather than a random high port: the
    # ephemeral range (32768+) can collide with outbound connections, and an
    # address people have to re-learn every reboot is worse than a clash.
    candidates = [8080, 8090, 8100, 8181, 8200, 8280, 8380, 8480, 8580, 8680]
    for port in candidates:
        if bindable(port):
            break
    else:
        print("NONE")
        sys.exit(1)
else:
    port = int(request)
    if not bindable(port):
        print(f"BUSY {port}")
        sys.exit(1)

config = get_config()
changed, errors = config.update({"DASHBOARD_PORT": port})
if errors:
    print("ERROR " + "; ".join(f"{k}: {v}" for k, v in errors.items()))
    sys.exit(1)
print(f"OK {port}")
PYEOF
)" || true

  case "$chosen" in
    "OK "*)
      local port="${chosen#OK }"
      if [ "$port" = "$current" ]; then
        good "port $port is free and already the room's — nothing to change"
      else
        good "moved the room to port $port"
      fi
      printf '\n'
      dim "Restarting the room software and the TV display…"
      cmd_units restart backend
      cmd_units restart browser
      sleep 2
      printf '\n'
      cmd_panel
      ;;
    "BUSY "*)
      red "Port ${chosen#BUSY } is already in use."
      dim "  roomctl screen        # see what owns it"
      dim "  roomctl port auto     # let it pick a free one"
      exit 1
      ;;
    NONE)
      red "Every candidate port is busy. Pick one by hand:  roomctl port 9123"
      exit 1
      ;;
    *)
      red "Could not change the port. ${chosen}"
      exit 1
      ;;
  esac
}

cmd_performance() {
  room_load_config || true
  local configured wanted
  configured="$(room_config PERFORMANCE_PROFILE auto)"

  wanted="${1:-}"
  if [ -z "$wanted" ]; then
    bold "Performance"
    printf '  %-10s %s\n' "machine" "$(room_config _MACHINE 'unknown hardware')"
    printf '  %-10s %s\n' "running" "$(room_config _PROFILE balanced)"
    if [ "$configured" = "auto" ]; then
      dim "  Chosen automatically. Override:  roomctl performance high|balanced|low"
    else
      dim "  Set by hand to '$configured'. Back to automatic:  roomctl performance auto"
    fi
    return 0
  fi

  case "$wanted" in
    auto | high | balanced | low) ;;
    *)
      red "Usage: roomctl performance [auto|high|balanced|low]"
      exit 1
      ;;
  esac

  cmd_set PERFORMANCE_PROFILE "$wanted"
  cmd_units restart backend
  cmd_units restart browser
  printf '\n'
  room_load_config || true
  cmd_performance
}

cmd_slow_device() {
  # A Pi 3 is roughly five times slower than a Pi 5 and has a quarter of the
  # memory. The defaults assume a Pi 5, so on older hardware the appliance
  # starts pressing join buttons before the meeting page has finished drawing
  # and can run out of time before it is ready. This retunes the timings and
  # drops the work the dashboard does between meetings.
  case "${1:-}" in
    on)
      bold "Retuning for slower hardware"
      cmd_set PERFORMANCE_PROFILE low          # stop guessing; assume the worst
      cmd_set AUTO_OPEN_MINUTES 4              # open the page well before the start
      cmd_set JOIN_SETTLE_SECONDS 30           # let it finish drawing first
      cmd_set AUTO_JOIN_TIMEOUT_SECONDS 300    # keep trying for five minutes
      cmd_set CALENDAR_REFRESH_SECONDS 60      # half the calendar work
      cmd_set HEALTH_CHECK_SECONDS 30          # half the monitoring work
      cmd_set BACKGROUND_MODE theme            # no image decoding or crossfades
      printf '\n'
      dim "Applied. Restarting the room software so it takes effect."
      cmd_units restart backend
      printf '\n'
      dim "This gives the join automation a much better chance. It cannot make"
      dim "the video call itself smooth — see the hardware note in README.md."
      ;;
    off)
      bold "Restoring the standard timings"
      cmd_set PERFORMANCE_PROFILE auto         # let the machine speak for itself
      cmd_set AUTO_OPEN_MINUTES 1
      cmd_set JOIN_SETTLE_SECONDS 0
      cmd_set AUTO_JOIN_TIMEOUT_SECONDS 90
      cmd_set CALENDAR_REFRESH_SECONDS 30
      cmd_set HEALTH_CHECK_SECONDS 15
      cmd_units restart backend
      ;;
    *)
      red "Usage: roomctl slow-device on | off"
      exit 1
      ;;
  esac
}

cmd_doctor() {
  bold "1/3  Conference bar"
  "$HERE/detect-poly.sh" || true
  bold "2/3  Remote / controller"
  "$HERE/diagnose-remote.sh" --list || true
  bold "3/3  Room status"
  cmd_status
}

cmd_reset() {
  printf 'Reset every setting to its default? The calendar link and PIN are kept. [y/N] '
  read -r answer
  case "$answer" in
    y | Y | yes) ;;
    *) dim "Cancelled."; exit 0 ;;
  esac
  py - << 'PYEOF'
import sys

sys.path.insert(0, ".")
from app.config import get_config

changed = get_config().reset_to_defaults(
    keep=("CALENDAR_ICS_URL", "CALENDAR_SOURCE", "ADMIN_PIN", "ADMIN_LAN_ACCESS",
          "ROOM_NAME", "TIMEZONE")
)
print(f"  {len(changed)} setting(s) reset.")
PYEOF
  cmd_units restart all
}

cmd_appliance() {
  local action="$1"
  local unit
  for unit in "${UNITS[@]}"; do
    printf '  %s %s… ' "$action" "$unit"
    if systemctl --user "$action" "$unit" 2>/dev/null; then green "ok"; else red "failed"; fi
  done
  if [ "$action" = "enable" ]; then
    systemctl --user start "${UNITS[@]}" 2>/dev/null || true
  else
    systemctl --user stop "${UNITS[@]}" 2>/dev/null || true
  fi
}

# ------------------------------------------------------------------ minutes
#
# app/minutes records a meeting, transcribes it, works out who spoke, asks
# Claude for a summary and emails it out. Everything below drives the *running*
# appliance over its own HTTP API rather than reading var/minutes, because the
# appliance owns those files and may be half-way through writing one.
#
# A request from 127.0.0.1 is already an administrator (is_local_request, in
# app/web_security.py), so reading needs no secret at all. Anything that
# changes something must carry the page token as well, exactly as the browser
# does — minutes_sign_in collects one. room_post_internal is not used here
# because this feature has no /api/internal/ routes to post to; if you add
# some, move these calls onto them and delete minutes_sign_in.
#
# With nothing answering on the port, every read falls back to the files and
# says so. Somebody who has just SSHed into a Pi whose dashboard will not start
# is exactly the person these commands are for.

# Resolved once, by cmd_minutes.
MINUTES_PORT=8080
MINUTES_VAR=""
MINUTES_ON=""
MINUTES_UP=""
MINUTES_COOKIE=""
MINUTES_TOKEN=""
# Set while printing something meant to be piped, so notes go to stderr and
# what lands on stdout is exactly the transcript (or exactly the summary).
MINUTES_BARE=""

minutes_note() {
  if [ -n "$MINUTES_BARE" ]; then dim "  $*" >&2; else dim "  $*"; fi
}

minutes_problem() {
  if [ -n "$MINUTES_BARE" ]; then red "  $*" >&2; else red "  $*"; fi
}

# A blank line that follows its notes, so that --transcript stays pipeable.
minutes_gap() {
  if [ -n "$MINUTES_BARE" ]; then printf '\n' >&2; else printf '\n'; fi
}

# minutes_appliance — 0 when the room software is up and the feature is on.
minutes_appliance() {
  case "$MINUTES_UP" in
    yes) return 0 ;;
    no) return 1 ;;
  esac
  MINUTES_UP=no
  [ -n "$MINUTES_ON" ] || return 1
  command -v curl >/dev/null 2>&1 || return 1
  curl --silent --fail --max-time 5 --output /dev/null \
    "http://127.0.0.1:${MINUTES_PORT}/api/health" || return 1
  MINUTES_UP=yes
  return 0
}

# minutes_get PATH — the appliance's JSON answer on stdout.
minutes_get() {
  curl --silent --max-time 20 "http://127.0.0.1:${MINUTES_PORT}$1" 2>/dev/null
}

# minutes_sign_in — collect the token every state-changing request must carry.
#
# The appliance puts one in `<body data-csrf>` on every page it serves and
# checks it against the session cookie set alongside it, so that a form on
# somebody else's website cannot press this room's buttons. A script has to ask
# for the pair the same way a browser does; two extra requests is a far better
# trade than a second way into app/web_security.py.
minutes_sign_in() {
  [ -z "$MINUTES_TOKEN" ] || return 0
  local reply
  reply="$(curl --silent --max-time 10 --dump-header - \
             "http://127.0.0.1:${MINUTES_PORT}/" 2>/dev/null | tr -d '\r')" || return 1
  MINUTES_COOKIE="$(printf '%s\n' "$reply" |
    sed -n 's/^[Ss]et-[Cc]ookie: *\(session=[^;]*\).*/\1/p' | head -1)"
  MINUTES_TOKEN="$(printf '%s\n' "$reply" |
    sed -n 's/.*data-csrf="\([^"]*\)".*/\1/p' | head -1)"
  [ -n "$MINUTES_COOKIE" ] && [ -n "$MINUTES_TOKEN" ]
}

# minutes_send METHOD PATH — a call that changes something. JSON on stdout.
minutes_send() {
  local method="$1" path="$2"
  if ! minutes_sign_in; then
    printf '%s\n' '{"ok": false, "error": "The room software would not issue a page token. Restart it: roomctl restart backend"}'
    return 0
  fi
  curl --silent --max-time 120 --request "$method" \
    --header "Cookie: $MINUTES_COOKIE" \
    --header "X-Room-Token: $MINUTES_TOKEN" \
    --header 'Content-Type: application/json' \
    "http://127.0.0.1:${MINUTES_PORT}$path" 2>/dev/null
}

# minutes_preamble — the state of play, said once, before anything is printed.
# Returns 0 when the appliance can be asked, 1 when the answer has to come off
# the disk instead.
minutes_preamble() {
  if [ -z "$MINUTES_ON" ]; then
    minutes_note "Meeting minutes is switched off, so nothing is being recorded now."
    minutes_note "Turn it on with:  roomctl set MINUTES_ENABLED true"
    minutes_note "                  roomctl restart backend"
    minutes_note "Anything recorded before it was switched off is still on the disk:"
    minutes_gap
    return 1
  fi
  minutes_appliance && return 0
  minutes_note "The room software is not answering on port ${MINUTES_PORT}, so what follows"
  minutes_note "is read off the disk instead. What is being recorded right now, and what"
  minutes_note "the worker is doing, cannot be known from here."
  minutes_note "  reading  ${MINUTES_VAR}"
  minutes_note "  roomctl start backend   then   roomctl logs backend"
  minutes_gap
  return 1
}

# minutes_needs_appliance WHY — refuse a job only the running appliance can do,
# and say which of the two reasons it is.
minutes_needs_appliance() {
  minutes_appliance && return 0
  local line
  for line in "$@"; do red "  $line"; done
  if [ -z "$MINUTES_ON" ]; then
    dim "  Meeting minutes is switched off. Turn it on with:"
    dim "    roomctl set MINUTES_ENABLED true   then   roomctl restart backend"
  else
    dim "  Nothing is answering on port ${MINUTES_PORT}. Start it and try again:"
    dim "    roomctl start backend   then   roomctl logs backend"
  fi
  return 1
}

# minutes_python — the reader and the formatter, as a program on stdout.
#
# python3 rather than jq: no other script here needs jq, and this is a Python
# appliance, so python3 is certainly present and jq may not be. It is handed to
# python3 as an argument precisely so the records can arrive on stdin — a
# transcript is what people said in a private meeting, and it is never written
# to a file, not even a temporary one, and never logged.
minutes_python() {
  cat << 'PYEOF'
"""Format the meeting-minutes records for a terminal.

Called two ways. With "-" as the source the appliance's own JSON arrives on
stdin, which is the path to prefer: it owns var/minutes and may be writing to
it. With a directory the files are read here instead, which is all that is left
when the room software is not running.
"""

import json
import os
import re
import sys
import textwrap
from datetime import datetime

BOLD, DIM, RED, GREEN, YELLOW, OFF = (
    "\033[1m", "\033[2m", "\033[31m", "\033[32m", "\033[33m", "\033[0m"
)
TICK = f"{GREEN}✓{OFF}"
CROSS = f"{RED}✗{OFF}"
SESSION_ID = re.compile(r"^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$")

#: The order the capabilities are explained in: what has to work first, first.
CAPABILITIES = ("audio", "transcribe", "roster", "faces", "voices", "summary", "email")


def stop(message):
    sys.stderr.write(f"  {RED}{message}{OFF}\n")
    raise SystemExit(1)


def load(*parts):
    try:
        with open(os.path.join(*parts), encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def wrapped(text, indent="      "):
    for line in textwrap.wrap(str(text or "").strip(), width=78 - len(indent)):
        print(f"{DIM}{indent}{line}{OFF}")


def clock(seconds):
    """Seconds into a meeting as mm:ss, or h:mm:ss once it runs past the hour."""
    try:
        total = max(0, int(float(seconds or 0)))
    except (TypeError, ValueError):
        total = 0
    hours, rest = divmod(total, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"
    return f"{minutes:02d}:{secs:02d}"


def moment(stamp):
    """An ISO timestamp on the room's own clock, or None."""
    try:
        at = datetime.fromisoformat(str(stamp))
    except (TypeError, ValueError):
        return None
    if at.tzinfo is not None:
        try:
            at = at.astimezone()
        except (OSError, ValueError, OverflowError):
            pass
    return at


def when_short(stamp):
    at = moment(stamp)
    if at is None:
        return str(stamp or "")[:12]
    return f"{at.day} {at:%b} {at:%H:%M}"


def when_long(started, ended):
    """"28 August 2026, 09:00 – 09:32 (32 min)", as much of it as is known."""
    at = moment(started)
    if at is None:
        return str(started or "unknown")
    text = f"{at.day} {at:%B %Y}, {at:%H:%M}"
    done = moment(ended)
    if done is None:
        return f"{text} (no end recorded — it may have been interrupted)"
    minutes = int((done - at).total_seconds() // 60)
    return f"{text} – {done:%H:%M}  ({minutes} min)"


def fit(text, width):
    text = " ".join(str(text or "").split())
    return text if len(text) <= width else text[: width - 1] + "…"


def field(name, value):
    print(f"  {name:<12}{value}")


# ---------------------------------------------------------------------------
# Reading the files, when there is no appliance to ask
# ---------------------------------------------------------------------------


def session_ids(root):
    """Every recorded meeting on the disk, newest first (the id sorts by time)."""
    where = os.path.join(root, "sessions")
    try:
        names = os.listdir(where)
    except OSError:
        return []
    found = [
        name
        for name in names
        if SESSION_ID.match(name) and os.path.isdir(os.path.join(where, name))
    ]
    return sorted(found, reverse=True)


def read_row(root, session_id):
    """One list row, built to the same shape MinutesService.list_sessions gives."""
    where = os.path.join(root, "sessions", session_id)
    meta = load(where, "meta.json")
    if not isinstance(meta, dict):
        return None
    summary = load(where, "summary.json") or {}
    delivery = load(where, "delivery.json") or {}
    try:
        names = os.listdir(where)
    except OSError:
        names = []
    return {
        "session_id": session_id,
        "title": meta.get("title") or "",
        "started_at": meta.get("started_at") or "",
        "ended_at": meta.get("ended_at") or "",
        "provider": meta.get("provider") or "",
        "stage": meta.get("stage") or "",
        "error": meta.get("error") or "",
        "has_summary": bool(summary.get("ok")),
        "has_audio": any(name.endswith(".wav") for name in names),
        "sent_to": len(delivery.get("sent_to") or []),
    }


def read_session(root, session_id):
    """One meeting, to the same shape MinutesService.get_session gives."""
    where = os.path.join(root, "sessions", session_id)
    meta = load(where, "meta.json")
    if not isinstance(meta, dict):
        return None
    written = load(where, "transcript.json")
    if not isinstance(written, dict):
        written = None
    return {
        "session_id": session_id,
        "meta": meta,
        "transcript": written,
        "text": render_text(written),
        "speakers": speakers(written),
        "summary": load(where, "summary.json"),
        "delivery": load(where, "delivery.json"),
        "recipients": recipients(written, meta),
    }


def read_people(root):
    """The roster, counted rather than copied.

    A face or a voice is stored as an embedding, which is biometric data. It is
    counted here and never printed — the same rule Person.to_public_dict keeps
    for the browser.
    """
    payload = load(root, "people", "people.json")
    rows = payload.get("people") if isinstance(payload, dict) else None
    out = []
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        face = row.get("face")
        voice = row.get("voice")
        out.append(
            {
                "name": str(row.get("name") or ""),
                "email": str(row.get("email") or ""),
                "faces": len(face) if isinstance(face, list) else 0,
                "voices": len(voice) if isinstance(voice, list) else 0,
            }
        )
    out.sort(key=lambda person: person["name"].lower())
    return out


def segments(written):
    rows = (written or {}).get("segments")
    rows = [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []
    return sorted(rows, key=lambda row: float(row.get("start") or 0))


def label(row):
    """What goes in front of the line — Transcript.label(), kept in step."""
    speaker = str(row.get("speaker") or "").strip()
    if speaker:
        return speaker
    return "Remote speaker" if row.get("track") == "far-end" else "Room speaker"


def render_text(written):
    return "\n".join(
        f"[{clock(row.get('start'))}] {label(row)}: {' '.join(str(row.get('text') or '').split())}"
        for row in segments(written)
    )


def speakers(written):
    seen = []
    for row in segments(written):
        name = label(row)
        if name not in seen:
            seen.append(name)
    return seen


def recipients(written, meta):
    out, seen = [], set()
    people = (written or {}).get("participants")
    addresses = [
        person.get("email") for person in people if isinstance(person, dict)
    ] if isinstance(people, list) else []
    invited = (meta or {}).get("invited")
    if isinstance(invited, list):
        addresses += invited
    for address in addresses:
        clean = str(address or "").strip()
        if "@" not in clean or clean.lower() in seen:
            continue
        seen.add(clean.lower())
        out.append(clean)
    return out


# ---------------------------------------------------------------------------
# Where a payload comes from
# ---------------------------------------------------------------------------


def from_stdin():
    """The appliance's answer, or its complaint, said plainly and then stop."""
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        stop("The room software sent an answer this script could not read. "
             "Try: roomctl logs backend")
    if not isinstance(payload, dict):
        stop("The room software sent an answer this script could not read.")
    if not payload.get("ok"):
        stop(str(payload.get("error") or "The room software refused that."))
    return payload


# ---------------------------------------------------------------------------
# Printing
# ---------------------------------------------------------------------------


def print_status(data, live):
    stats = data.get("people") or {}
    field("meetings", f"{data.get('sessions', 0)} on this appliance")
    field(
        "people",
        f"{stats.get('people', 0)} enrolled — "
        f"{stats.get('with_face', 0)} with a face, {stats.get('with_voice', 0)} with a voice",
    )
    if not live:
        return
    recording = data.get("recording")
    if recording:
        print(
            f"  {GREEN}●{OFF} {'recording':<9} “{recording.get('title') or 'Untitled'}”"
            f"  {clock(recording.get('seconds'))} elapsed"
        )
        field("", recording.get("session_id") or "")
    else:
        field("recording", "nothing right now")
    queued = int(data.get("queued") or 0)
    working = str(data.get("working_on") or "").strip()
    if working:
        field("worker", f"{working}" + (f"   ({queued} more queued)" if queued else ""))
    elif queued:
        field("worker", f"idle — {queued} waiting to be written up")
    else:
        field("worker", "idle")
    if data.get("last_error"):
        print(f"  {YELLOW}last error{OFF}  {data['last_error']}")

    print()
    print(f"{BOLD}What it can do{OFF}")
    caps = data.get("capabilities") or {}
    for name in CAPABILITIES:
        cap = caps.get(name) or {}
        if not isinstance(cap, dict):
            continue
        mark = TICK if cap.get("ok") else CROSS
        print(f"  {mark} {name}")
        if not cap.get("ok"):
            # These reasons are written to be acted on — "…is not installed.
            # Install it with: pip install…" — so they are printed as they are.
            wrapped(cap.get("detail"))


def print_list(rows, limit):
    rows = [row for row in rows if isinstance(row, dict)][: max(1, limit)]
    if not rows:
        print(f"{DIM}  No meetings have been recorded on this appliance.{OFF}")
        return
    header = "  {:<24}  {:<12}  {:<20}  {:<8}  {:<11}  {:<7}  {}".format(
        "id", "when", "title", "provider", "stage", "summary", "emailed"
    )
    print(f"{DIM}{header}{OFF}")
    failed = False
    for row in rows:
        failed = failed or row.get("stage") == "failed"
        print(
            "  {:<24}  {:<12}  {:<20}  {:<8}  {:<11}  {:<7}  {}".format(
                row.get("session_id") or "",
                when_short(row.get("started_at")),
                fit(row.get("title") or "Untitled", 20),
                fit(row.get("provider") or "—", 8),
                fit(row.get("stage") or "—", 11),
                "yes" if row.get("has_summary") else "no",
                row.get("sent_to") or "no",
            )
        )
    if failed:
        print()
        print(f"{DIM}  A meeting at “failed” says why in:  roomctl minutes show <id>{OFF}")


def print_facts(session):
    meta = session.get("meta") or {}
    delivery = session.get("delivery") or {}
    print(f"{BOLD}Meeting{OFF}")
    field("id", session.get("session_id") or "")
    field("title", meta.get("title") or "Untitled")
    field("when", when_long(meta.get("started_at"), meta.get("ended_at")))
    field("provider", meta.get("provider") or "—")
    if meta.get("room"):
        field("room", meta["room"])
    if meta.get("organizer"):
        field("organiser", meta["organizer"])
    field("stage", meta.get("stage") or "—")
    if delivery.get("sent_to"):
        field("emailed", f"{len(delivery['sent_to'])} recipient(s)")
    elif delivery.get("error"):
        field("emailed", f"{RED}no{OFF} — {delivery['error']}")
    else:
        field("emailed", "not sent")
    if meta.get("error"):
        print(f"  {RED}{'error':<12}{OFF}{meta['error']}")


def print_people_in(session):
    written = session.get("transcript") or {}
    people = [p for p in (written.get("participants") or []) if isinstance(p, dict)]
    in_room = [p.get("name") for p in people if p.get("where") == "room"]
    remote = [p.get("name") for p in people if p.get("where") == "remote"]
    speaking = session.get("speakers") or []
    if not (in_room or remote or speaking):
        return
    print()
    print(f"{BOLD}Who was there{OFF}")
    if in_room:
        field("in the room", ", ".join(str(n) for n in in_room if n))
    if remote:
        field("dialled in", ", ".join(str(n) for n in remote if n))
    if speaking:
        field("spoke", ", ".join(str(n) for n in speaking if n))
    if session.get("recipients"):
        field("recipients", ", ".join(session["recipients"]))
    unknown = [n for n in speaking if n in ("Room speaker", "Remote speaker")]
    if unknown:
        wrapped(
            "Somebody in this transcript is unnamed. Putting a name to them on "
            "the /minutes page corrects the transcript and teaches the room "
            "that voice at the same time.",
            indent="  ",
        )


def summary_text(session):
    summary = session.get("summary")
    if not isinstance(summary, dict):
        return "", ""
    if summary.get("ok") and str(summary.get("text") or "").strip():
        return str(summary["text"]).strip(), ""
    return "", str(summary.get("error") or "").strip()


def print_session(session, view):
    if view == "transcript":
        text = str(session.get("text") or "")
        if not text.strip():
            stop("That meeting has no transcript yet. Its stage says how far it got: "
                 "roomctl minutes show " + str(session.get("session_id") or ""))
        print(text)
        return
    if view == "summary":
        text, why = summary_text(session)
        if not text:
            stop(why or "That meeting has no summary. Ask for one again with: "
                        "roomctl minutes process " + str(session.get("session_id") or ""))
        print(text)
        return

    print_facts(session)
    if view == "facts":
        return
    print_people_in(session)

    text, why = summary_text(session)
    print()
    print(f"{BOLD}Summary{OFF}")
    if text:
        for line in text.splitlines():
            print(f"  {line}")
    elif why:
        wrapped(why, indent="  ")
    else:
        session_id = str(session.get("session_id") or "")
        print(f"{DIM}  None yet. Ask for one with:  "
              f"roomctl minutes process {session_id}{OFF}")

    print()
    print(f"{BOLD}Transcript{OFF}")
    body = str(session.get("text") or "")
    if not body.strip():
        wrapped("Nothing was transcribed for this meeting.", indent="  ")
        return
    for line in body.splitlines():
        print(f"  {line}")
    for notice in (session.get("transcript") or {}).get("notices") or []:
        wrapped(notice, indent="  ")


def print_people(rows, stats):
    rows = [row for row in rows if isinstance(row, dict)]
    if not rows:
        print(f"{DIM}  Nobody is enrolled, so every speaker will be “Room speaker”.{OFF}")
        print(f"{DIM}  Add people, photos and voice samples on the /minutes page — a{OFF}")
        print(f"{DIM}  photo has to be uploaded and a voice has to be recorded in the{OFF}")
        print(f"{DIM}  room, and neither fits down a terminal.{OFF}")
        return
    header = "  {:<24}  {:<30}  {:<6}  {}".format("name", "email", "faces", "voices")
    print(f"{DIM}{header}{OFF}")
    for row in rows:
        print(
            "  {:<24}  {:<30}  {:<6}  {}".format(
                fit(row.get("name"), 24),
                fit(row.get("email") or "—", 30),
                row.get("faces") or 0,
                row.get("voices") or 0,
            )
        )
    if stats:
        print()
        print(
            f"{DIM}  {stats.get('with_face', 0)} of {stats.get('people', 0)} can be "
            f"recognised by face, {stats.get('with_voice', 0)} by voice.{OFF}"
        )


def print_detail(payload):
    detail = str(payload.get("detail") or "").strip()
    print(f"  {TICK} {detail or 'Done.'}")


# ---------------------------------------------------------------------------
# Entry
# ---------------------------------------------------------------------------


def main(argv):
    what = argv[1] if len(argv) > 1 else ""
    source = argv[2] if len(argv) > 2 else "-"
    args = argv[3:]
    live = source == "-"

    if what == "status":
        if live:
            data = from_stdin()
        else:
            roster = read_people(source)
            data = {
                "sessions": len(session_ids(source)),
                "people": {
                    "people": len(roster),
                    "with_face": sum(1 for person in roster if person["faces"]),
                    "with_voice": sum(1 for person in roster if person["voices"]),
                },
            }
        print_status(data, live)
        return

    if what == "list":
        limit = int(args[0]) if args and args[0].isdigit() else 20
        if live:
            rows = from_stdin().get("sessions") or []
        else:
            rows = [read_row(source, i) for i in session_ids(source)[:limit]]
            rows = [row for row in rows if row]
        print_list(rows, limit)
        return

    if what == "show":
        session_id = args[0] if args else ""
        view = args[1] if len(args) > 1 else "full"
        session = from_stdin().get("session") if live else read_session(source, session_id)
        if not isinstance(session, dict):
            stop(f"Nothing on this appliance is recorded under {session_id}.")
        print_session(session, view)
        return

    if what == "people":
        if live:
            payload = from_stdin()
            print_people(payload.get("people") or [], payload.get("stats") or {})
        else:
            print_people(read_people(source), {})
        return

    if what == "resolve":
        prefix = args[0] if args else ""
        if live:
            ids = [
                str(row.get("session_id") or "")
                for row in from_stdin().get("sessions") or []
                if isinstance(row, dict)
            ]
        else:
            ids = session_ids(source)
        if not ids:
            print("NONE")
        elif not prefix:
            print("OK " + ids[0])       # the newest; the ids sort by time
        elif prefix in ids:
            print("OK " + prefix)
        else:
            hits = [i for i in ids if i.startswith(prefix)]
            if len(hits) == 1:
                print("OK " + hits[0])
            elif not hits:
                print("NONE")
            else:
                print("\n".join(["MANY"] + hits))
        return

    if what == "remove":
        where = os.path.join(source, "sessions", args[0] if args else "")
        if not SESSION_ID.match(args[0] if args else "") or not os.path.isdir(where):
            stop("Nothing on this appliance is recorded under that id.")
        import shutil

        try:
            shutil.rmtree(where)
        except OSError as exc:
            stop(f"That meeting could not be deleted: {exc}")
        print(f"  {TICK} That meeting — audio, transcript and summary — has been deleted.")
        return

    if what == "detail":
        print_detail(from_stdin())
        return

    stop(f"minutes: nothing renders “{what}”.")


main(sys.argv)
PYEOF
}

# minutes_render WHAT SOURCE [ARG…] — the records as text on stdout. SOURCE is
# "-" to read the appliance's JSON from stdin, or the directory to read instead.
minutes_render() {
  py -c "$(minutes_python)" "$@"
}

# minutes_resolve PREFIX — a full session id on stdout, git-style.
#
# Session ids are long and nobody retypes one correctly. An unambiguous leading
# part is enough, an empty one means the most recent meeting, and an ambiguous
# one is refused with the candidates rather than guessed at. Everything except
# the id itself goes to stderr, so the caller can capture the answer.
minutes_resolve() {
  local prefix="${1:-}" answer
  if minutes_appliance; then
    answer="$(minutes_get "/api/minutes/sessions?limit=200" |
              minutes_render resolve - "$prefix" 2>/dev/null)"
  else
    answer="$(minutes_render resolve "$MINUTES_VAR" "$prefix")"
  fi
  case "$answer" in
    "OK "*)
      printf '%s\n' "${answer#OK }"
      ;;
    MANY*)
      red "  '$prefix' is the start of more than one meeting:" >&2
      printf '%s\n' "$answer" | tail -n +2 | while read -r candidate; do
        dim "    $candidate" >&2
      done
      dim "  Give enough of the id to pick one." >&2
      return 1
      ;;
    *)
      if [ -z "$prefix" ]; then
        red "  No meetings have been recorded on this appliance." >&2
      else
        red "  Nothing recorded here starts with '$prefix'." >&2
        dim "    roomctl minutes list      # what is actually here" >&2
      fi
      return 1
      ;;
  esac
}

cmd_minutes_status() {
  bold "Meeting minutes"
  if minutes_preamble; then
    minutes_get /api/minutes/status | minutes_render status -
  else
    minutes_render status "$MINUTES_VAR"
  fi
}

cmd_minutes_list() {
  local limit="${1:-20}"
  case "$limit" in
    '' | *[!0-9]*)
      red "Usage: roomctl minutes list [how many]"
      exit 1
      ;;
  esac
  bold "Meetings"
  if minutes_preamble; then
    minutes_get "/api/minutes/sessions?limit=${limit}" | minutes_render list - "$limit"
  else
    minutes_render list "$MINUTES_VAR" "$limit"
  fi
}

cmd_minutes_show() {
  local view=full wanted=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --transcript | -t)
        view=transcript
        MINUTES_BARE=1
        ;;
      --summary | -s)
        view=summary
        MINUTES_BARE=1
        ;;
      -*)
        red "Unknown option '$1'."
        dim "Use: roomctl minutes show [id] [--transcript | --summary]"
        exit 1
        ;;
      *) wanted="$1" ;;
    esac
    shift
  done

  local id
  id="$(minutes_resolve "$wanted")" || exit 1
  if minutes_preamble; then
    minutes_get "/api/minutes/sessions/${id}" | minutes_render show - "$id" "$view"
  else
    minutes_render show "$MINUTES_VAR" "$id" "$view"
  fi
}

cmd_minutes_process() {
  local id
  id="$(minutes_resolve "${1:-}")" || exit 1
  minutes_needs_appliance \
    "Nothing was queued. Only the running appliance can do this: the worker" \
    "that writes a meeting up lives inside it." || exit 1
  minutes_send POST "/api/minutes/sessions/${id}/reprocess" | minutes_render detail -
}

cmd_minutes_delete() {
  local yes="" wanted="" id answer
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes | -y) yes=1 ;;
      -*)
        red "Unknown option '$1'."
        dim "Use: roomctl minutes delete <session-id> [--yes]"
        exit 1
        ;;
      *) wanted="$1" ;;
    esac
    shift
  done
  [ -n "$wanted" ] || { red "Usage: roomctl minutes delete <session-id> [--yes]"; exit 1; }

  id="$(minutes_resolve "$wanted")" || exit 1
  local live=1
  minutes_preamble || live=""

  # Show what is about to go before asking. An id is not a meeting to anybody.
  if [ -n "$live" ]; then
    minutes_get "/api/minutes/sessions/${id}" | minutes_render show - "$id" facts
  else
    minutes_render show "$MINUTES_VAR" "$id" facts
  fi

  if [ -z "$yes" ]; then
    printf '\nDelete this meeting — audio, transcript and summary? There is no undo. [y/N] '
    read -r answer
    case "$answer" in
      y | Y | yes) ;;
      *) dim "Cancelled. Nothing was deleted."; exit 0 ;;
    esac
  fi

  if [ -n "$live" ]; then
    minutes_send DELETE "/api/minutes/sessions/${id}" | minutes_render detail -
  else
    minutes_render remove "$MINUTES_VAR" "$id"
  fi
}

cmd_minutes_sweep() {
  room_load_config || true
  local keep audio
  keep="$(room_config MINUTES_KEEP_DAYS 30)"
  audio="$(room_config MINUTES_KEEP_AUDIO_DAYS 0)"

  bold "Retention"
  printf '  %-11s %s\n' "meetings" "kept for $keep day(s), then deleted"
  if [ "$audio" = "0" ]; then
    printf '  %-11s %s\n' "audio" "deleted as soon as the meeting is transcribed"
  else
    printf '  %-11s %s\n' "audio" "kept for $audio day(s)"
  fi
  printf '  %-11s %s\n' "change it" "roomctl set MINUTES_KEEP_DAYS <days>"
  printf '\n'

  minutes_needs_appliance \
    "Nothing was deleted. Only the running appliance applies the retention" \
    "policy, so that it and this script can never disagree about it." || exit 1
  minutes_send POST /api/minutes/sweep | minutes_render detail -
}

cmd_minutes_people() {
  bold "People this room can recognise"
  if minutes_preamble; then
    minutes_get /api/minutes/people | minutes_render people -
  else
    minutes_render people "$MINUTES_VAR"
  fi
}

cmd_minutes() {
  room_load_config || true
  MINUTES_PORT="$(room_config DASHBOARD_PORT 8080)"
  MINUTES_VAR="${ROOM_APPLIANCE_VAR:-$ROOM_ROOT/var}/minutes"
  if room_is_true "$(room_config MINUTES_ENABLED false)"; then MINUTES_ON=1; fi

  local action="${1:-status}"
  shift || true
  case "$action" in
    status | st) cmd_minutes_status ;;
    list | ls) cmd_minutes_list "$@" ;;
    show | cat) cmd_minutes_show "$@" ;;
    process | reprocess) cmd_minutes_process "$@" ;;
    delete | rm) cmd_minutes_delete "$@" ;;
    sweep | prune) cmd_minutes_sweep ;;
    people | who) cmd_minutes_people ;;
    help | -h | --help) usage ;;
    *)
      red "Unknown minutes action '$action'."
      dim "Use: status | list | show | process | delete | sweep | people"
      exit 1
      ;;
  esac
}

# --------------------------------------------------------------------- main

COMMAND="${1:-status}"
shift || true

case "$COMMAND" in
  status | st)       cmd_status ;;
  screen | tv)       cmd_screen ;;
  panel | url)       cmd_panel ;;
  qr | code)         cmd_qr "$@" ;;
  port)              cmd_port "$@" ;;
  doctor | check)    cmd_doctor ;;
  performance | perf) cmd_performance "$@" ;;
  slow-device | slow) cmd_slow_device "$@" ;;
  restart)           cmd_units restart "$@" ;;
  start)             cmd_units start "$@" ;;
  stop)              cmd_units stop "$@" ;;
  logs | log)        cmd_logs "$@" ;;
  config | settings) cmd_config ;;
  get)               cmd_get "$@" ;;
  set)               cmd_set "$@" ;;
  calendar | cal)    cmd_calendar "$@" ;;
  pin)               cmd_pin "$@" ;;
  lan-admin | lan)   cmd_lan_admin "$@" ;;
  minutes | mins)    cmd_minutes "$@" ;;
  update | pull)     cmd_update ;;
  reset)             cmd_reset ;;
  reboot)            dim "Rebooting…"; sudo -n systemctl reboot || sudo systemctl reboot ;;
  enable)            cmd_appliance enable ;;
  disable)           cmd_appliance disable ;;
  help | -h | --help) usage ;;
  *) red "Unknown command '$COMMAND'"; printf '\n'; usage; exit 1 ;;
esac
